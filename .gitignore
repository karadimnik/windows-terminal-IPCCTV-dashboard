# ========================
# Project Specific
# ========================
# Ignore generated credentials and local camera configurations
camera_creds.xml
# The restreamer control API login, generated by the product (DPAPI)
relay_api_creds.xml
# The live-view login's secret, generated by the product (user-only ACL)
live_view_secret.txt
cameras.json
# Local recorder config; copy recorder.config.example.json to create it
recorder.config.json

# ========================
# PowerShell & Logs
# ========================
*.log
*.err
*Error.txt

# ========================
# VS Code
# ========================
.vscode/

# ========================
# Windows OS
# ========================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Local design mockups, not part of the project
mockups/

# Built UI binary, cross-compiled from ui/ (see ui/build.sh)
camui.exe
camui.config.json

# Agent working notes for this workspace - local to the machine, never published
.claude/

# Never commit key or certificate material (a MediaMTX started in the wrong folder writes auto.crt/auto.key)
*.key
*.crt
*.pem
*.pfx

# Local CA and server keys for the LAN HTTPS listener (normally outside the repo, in %LOCALAPPDATA%\IPCCTV\tls)
tls/
